aegis_gateway:
  host: "localhost"
  port: 8081

merchant_mcp:
  host: "localhost"
  port: 8082

database:
  dsn: "postgres://postgres:postgres@localhost:5432/aegis_test?sslmode=disable"

razorpay:
  key_id: "rzp_test_123"
  key_secret: "test_secret_123"

razorpay_mcp:
  binary_path: ""

policy:
  spend_cap_paisa: 300000
  per_sku_cap:
    "SHOE-E2E-001": 5
  velocity_cap:
    max_requests: 10
    window_seconds: 60
  allowed_categories: ["footwear", "apparel"]
  blocked_skus: []
  geo_rules:
    - country: "IN"
      allowed: true
      pincodes: ["400001", "560001", "560002", "999999"]

audit:
  retention_days: 90

approval_queue:
  default_ttl_hours: 24

log:
  level: "debug"
